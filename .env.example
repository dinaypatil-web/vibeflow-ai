# VibeFlow AI Environment Variables

# Server Configuration
PORT=4000
NODE_ENV=development

# Server-Based Database Configuration (Turso Edge SQLite Database)
# ────────────────────────────────────────────────────────────────
# To connect to Turso:
# 1. Create a free Turso DB: turso db create vibeflow-db
# 2. Set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN (in Vercel & locally)
# If left blank, VibeFlow automatically falls back to local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Database Configuration (PostgreSQL / Legacy)
DATABASE_URL=postgresql://vibeflow:vibeflow_secret@localhost:5432/vibeflow_db

# Security
JWT_SECRET=vibeflow-super-secret-key-2026-production

# External API Integrations
# ────────────────────────────────────────────────────────────────
# YouTube Data API v3 (Optional) — enables live YT search
YOUTUBE_API_KEY=

# Spotify Web API (Optional) — enables 30s preview streams
# Get free credentials at: https://developer.spotify.com → Create App
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Providers that require NO API keys (always active) ──────────
# Deezer         — 70M+ tracks, 30s MP3 previews via public catalog API
# JioSaavn       — Full-length Bollywood/Hindi/Indian music (unofficial public API)
# SoundCloud     — Indie/remix embedding via public widget
# iTunes/Apple   — Preview streams via public iTunes Search API
# Audius         — Full master tracks via open decentralized API
